///|
/// Tool call kind
pub(all) enum ToolCallKind {
  Function
  WebSearch
} derive(Show, Eq)

///|
/// Output text annotation
pub(all) enum ResponseAnnotation {
  UrlCitation(
    title~ : String?,
    url~ : String,
    start_index~ : Int,
    end_index~ : Int
  )
} derive(Show, Eq)

///|
/// Tool call status
pub(all) enum ToolCallStatus {
  InProgress
  Searching
  Completed
} derive(Show, Eq)

///|
/// Tool call trace metadata
pub(all) struct ToolCallTrace {
  id : String
  name : String
  kind : ToolCallKind
  statuses : Array[ToolCallStatus]
  arguments : Json
}

// =============================================================================
// Response Content Parts (model → consumer)
//
// Unified representation of output content blocks across providers.
// Each variant documents which provider APIs it maps to.
// =============================================================================

///|
/// Model output content part
pub(all) enum ResponseContentPart {
  /// Text output
  /// - OpenAI Responses API: {"type":"output_text","text":"...","annotations":[...]}
  ///   Ref: ResponseOutputMessage.content
  /// - OpenAI Chat Completions: message.content (string)
  ///   Ref: ChatCompletionMessage.content
  /// - Anthropic: {"type":"text","text":"..."}
  ///   Ref: https://platform.claude.com/docs/en/api/messages — TextBlock
  /// - Gemini: {"text":"..."}
  ///   Ref: https://ai.google.dev/api/generate-content — Part.text
  OutputText(String)
  /// Image output (generated image URL)
  /// - OpenAI Responses API: {"type":"output_image","image_url":"..."}
  ///   Ref: ResponseOutputMessage.content — only with image generation models
  /// - Anthropic: not supported as output (image blocks are input-only)
  /// - Gemini: may return inlineData with image/* mime (image generation models)
  OutputImage(url~ : String)
  /// Model refusal
  /// - OpenAI Responses API: {"type":"refusal","refusal":"..."}
  ///   Ref: ResponseOutputMessage.content — refusal content part
  /// - OpenAI Chat Completions: message.refusal (string)
  ///   Ref: ChatCompletionMessage.refusal
  /// - Anthropic: returned as text with stop_reason="end_turn" (no dedicated type)
  /// - Gemini: returned as finishReason="SAFETY" (no dedicated type)
  Refusal(String)
  /// Thinking/reasoning output
  /// - OpenAI Responses API: {"type":"reasoning","summary":[{"type":"summary_text","text":"..."}],"content":[{"type":"reasoning_text","text":"..."}]}
  ///   Ref: ResponseReasoningItem
  /// - Anthropic: {"type":"thinking","thinking":"..."}
  ///   Ref: https://platform.claude.com/docs/en/api/messages — ThinkingBlock
  /// - Gemini: not exposed (reasoning is internal to the model)
  Thinking(text~ : String)
  /// Redacted/encrypted thinking (Anthropic only)
  /// - Anthropic: {"type":"redacted_thinking","data":"..."}
  ///   Ref: https://platform.claude.com/docs/en/api/messages — RedactedThinkingBlock
  RedactedThinking(data~ : String)
  /// Executable code generated by the model
  /// - Gemini: {"executableCode":{"language":"PYTHON","code":"..."}}
  ///   Ref: https://ai.google.dev/api/generate-content — Part.executableCode
  /// - Anthropic: corresponds to code within server_tool_use (code_execution)
  CodeExecution(language~ : String, code~ : String)
  /// Code execution result
  /// - Gemini: {"codeExecutionResult":{"outcome":"OUTCOME_OK","output":"..."}}
  ///   Ref: https://ai.google.dev/api/generate-content — Part.codeExecutionResult
  /// - Anthropic: {"type":"code_execution_tool_result","content":{"stdout":"...","stderr":"...","return_code":0}}
  ///   Ref: https://platform.claude.com/docs/en/api/messages — CodeExecutionToolResultBlock
  CodeResult(outcome~ : String, output~ : String)
  /// Audio output
  /// - OpenAI Chat Completions: message.audio = {"id":"...","data":"base64...","transcript":"...","expires_at":N}
  ///   Ref: ChatCompletionAudio
  /// - Anthropic: not supported as output
  /// - Gemini: not supported as output
  AudioOutput(data~ : String, transcript~ : String)
} derive(Show, Eq)

///|
/// Rich text response metadata
pub(all) struct RichTextResponse {
  /// Plain text content (concatenated text parts, for backward compatibility)
  content : String
  /// Structured content parts (text, images, refusals, thinking, code execution, etc.)
  /// None when response is text-only (backward compatible)
  content_parts : Array[ResponseContentPart]?
  annotations : Array[ResponseAnnotation]
  tool_traces : Array[ToolCallTrace]
}

// =============================================================================
// Input Content Parts (consumer → model)
//
// Unified representation of input content blocks across providers.
// =============================================================================

///|
/// Multimodal content part for User messages
pub(all) enum ContentPart {
  /// Text content
  /// - OpenAI Chat: {"type":"text","text":"..."}
  /// - OpenAI Responses: {"type":"input_text","text":"..."}
  /// - Anthropic: {"type":"text","text":"..."}
  /// - Gemini: {"text":"..."}
  Text(String)
  /// Image referenced by URL
  /// - OpenAI Chat: {"type":"image_url","image_url":{"url":"...","detail":"auto|low|high"}}
  /// - OpenAI Responses: {"type":"input_image","image_url":"...","detail":"..."}
  /// - Anthropic: {"type":"image","source":{"type":"url","url":"..."}}
  /// - Gemini: {"fileData":{"fileUri":"...","mimeType":"image/*"}}
  ImageUrl(url~ : String, detail~ : String?)
  /// Base64-encoded inline image
  /// - OpenAI Chat: {"type":"image_url","image_url":{"url":"data:image/png;base64,..."}}
  /// - OpenAI Responses: {"type":"input_image","image_url":"data:image/png;base64,..."}
  /// - Anthropic: {"type":"image","source":{"type":"base64","media_type":"image/png","data":"..."}}
  /// - Gemini: {"inlineData":{"mimeType":"image/png","data":"..."}}
  ImageBase64(data~ : String, media_type~ : String)
  /// Audio input (base64-encoded)
  /// - OpenAI Chat: {"type":"input_audio","input_audio":{"data":"...","format":"wav|mp3"}}
  ///   Ref: ChatCompletionContentPartInputAudio — gpt-4o-audio-preview etc.
  /// - Gemini: {"inlineData":{"mimeType":"audio/wav","data":"..."}}
  ///   Ref: https://ai.google.dev/gemini-api/docs/audio — supported: wav,mp3,aiff,aac,ogg,flac
  /// - Anthropic: not supported
  Audio(data~ : String, format~ : String)
  /// Document content (base64-encoded PDF, plain text, etc.)
  /// - OpenAI Chat: {"type":"file","file":{"file_data":"...","filename":"..."}}
  ///   Ref: docs/upstream/openai-chat-completions.md:194-218
  /// - Anthropic: {"type":"document","source":{"type":"base64","media_type":"application/pdf","data":"..."},"title":"..."}
  ///   Ref: https://platform.claude.com/docs/en/api/messages — DocumentBlockParam
  /// - Gemini: {"inlineData":{"mimeType":"application/pdf","data":"..."}} (<=50MB)
  ///   Ref: https://ai.google.dev/gemini-api/docs/document-processing
  Document(data~ : String, media_type~ : String, title~ : String?)
  /// File reference (uploaded file ID or URI)
  /// - OpenAI Chat: {"type":"file","file":{"file_id":"..."}}
  ///   Ref: docs/upstream/openai-chat-completions.md:194-218
  /// - OpenAI Responses: {"type":"input_file","file_id":"..."}
  /// - Anthropic: {"type":"document","source":{"type":"file","file_id":"file_..."}}
  ///   Ref: Anthropic Files API
  /// - Gemini: {"fileData":{"fileUri":"files/...","mimeType":"..."}}
  ///   Ref: Gemini Files API
  FileRef(file_id~ : String, media_type~ : String?)
  /// Video content (base64-encoded)
  /// - Gemini: {"inlineData":{"mimeType":"video/mp4","data":"..."}}
  ///   Ref: https://ai.google.dev/gemini-api/docs/video-understanding
  ///   Supported: mp4,mpeg,mov,avi,x-flv,mpg,webm,wmv,3gpp
  /// - OpenAI Chat: no native video content part in ChatCompletionContentPart
  ///   Ref: docs/upstream/openai-chat-completions.md:126-218
  /// - Anthropic: not natively supported
  Video(data~ : String, media_type~ : String)
} derive(Show, Eq)

///|
/// Tool call request
pub(all) struct ToolCallRequest {
  /// Call ID
  id : String
  /// Tool name
  name : String
  /// Arguments (JSON format)
  arguments : Json
  /// Tool call kind
  kind : ToolCallKind
}

///|
/// Message sent to model
pub(all) enum ModelMessage {
  /// System message
  System(String)
  /// User message (content_parts overrides content when present for multimodal)
  User(content~ : String, name~ : String?, content_parts~ : Array[ContentPart]?)
  /// Assistant message
  Assistant(content~ : String, tool_calls~ : Array[ToolCallRequest]?)
  /// Tool execution result
  ToolResult(tool_call_id~ : String, content~ : String)
}

///|
/// Tool execution result
pub(all) enum ToolResult {
  /// Success
  Success(content~ : String)
  /// Error
  Error(message~ : String)
  /// Requires additional tool call
  RequiresAction(next_tool~ : String, arguments~ : Json)
}

///|
/// Model response
pub(all) enum ModelResponse {
  /// Text response
  Text(String)
  /// Text response with annotations or tool traces
  RichText(RichTextResponse)
  /// Tool call request
  ToolCalls(Array[ToolCallRequest])
  /// Error
  ModelError(String)
  /// Rate limited
  RateLimited(retry_after~ : Int)
}
